# HIT-Website Project Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://hit_user:hit_password@localhost:5432/hit_db"

# =============================================================================
# Redis Configuration
# =============================================================================
# Redis connection string for caching
REDIS_URL="redis://localhost:6379"

# =============================================================================
# NextAuth.js Configuration
# =============================================================================
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# Canonical public base URL of the application. Used for auth redirects,
# email notification links, and schedule share links (QR/short link).
# In production set this to the public hostname (NOT the internal bind
# address), e.g. https://hit-website-virtuos-openstack.uni-osnabrueck.de
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# Application Configuration
# =============================================================================
# Environment (development, staging, production)
NODE_ENV="development"

# =============================================================================
# AI/LLM Configuration (Studiennavigator)
# =============================================================================
# Any OpenAI-compatible chat-completions endpoint (LiteLLM, vLLM, Ollama, OpenAI).
# Without OPENAI_API_BASE_URL / OPENAI_API_KEY the navigator returns 503 and the
# UI shows "nicht erreichbar" — there is no offline fallback.
OPENAI_API_BASE_URL=""
OPENAI_API_KEY=""
# Model name as the gateway knows it, e.g. "RedHatAI/gemma-4-31B-it-FP8-Dynamic"
OPENAI_MODEL="gpt-4o-mini"

# =============================================================================
# Google Maps Directions API
# =============================================================================
# Server-side only, for walking route calculation between campus buildings.
# Included in university Google Cloud contract.
# GOOGLE_MAPS_API_KEY=""

# =============================================================================
# Email Notifications (SMTP via UOS Relay)
# =============================================================================
# No authentication needed — relay.rz.uni-osnabrueck.de accepts mail
# from within the university network without credentials.
# SMTP_HOST="relay.rz.uni-osnabrueck.de"
# SMTP_PORT="25"
# EMAIL_FROM="hit@zsb.os.de"
# EMAIL_TO="hit@zsb.os.de"

# =============================================================================
# Public Contact Email
# =============================================================================
# Address shown in the public site footer ("Kontakt" column). Read at
# request time on the server, so it is runtime-configurable per deployment
# without rebuilding the Docker image. Defaults to hit@zsb.os.de when unset.
# CONTACT_EMAIL="hit@zsb.os.de"

# =============================================================================
# Static HTML Export
# =============================================================================
# EXPORT_API_KEY=""

# =============================================================================
# Matomo Analytics (cookieless)
# =============================================================================
# NEXT_PUBLIC_MATOMO_URL=""
# NEXT_PUBLIC_MATOMO_SITE_ID=""

# =============================================================================
# Homepage Hero Banner
# =============================================================================
# Toggle the animated SVG hero banner on the homepage. When unset or != "true",
# the static PNG hero (public/infotag-banner.png) is used.
#
# This is a NEXT_PUBLIC_* variable, which Next.js inlines into the client
# bundle at build time. In dev (`npm run dev`), the value in .env.local is
# read on each request. In production it must be set at `npm run build`
# (e.g. as a Docker build-arg in CI), not at container startup.
# NEXT_PUBLIC_ANIMATED_BANNER="true"

# =============================================================================
# Performance Monitoring
# =============================================================================
# Enable performance metric collection in non-development environments.
# In development this is always on. Set to "true" to enable in production.
# ENABLE_PERFORMANCE_MONITORING="false"

